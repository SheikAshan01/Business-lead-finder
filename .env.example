# ============================================================
# SRA BUSINESS LEAD FINDER - ENVIRONMENT CONFIGURATION
# ============================================================

# Application
APP_NAME="SRA Business Lead Finder"
TAGLINE="Find. Verify. Connect."

# Database URL
# For local dev without docker: sqlite:///./sra_leads.db
# For PostgreSQL docker: postgresql+psycopg://sra:sra_password@localhost:5432/sra_leads
DATABASE_URL=sqlite:///./sra_leads.db

# Redis Broker & Celery Queue
# For local dev without docker: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Security Secrets (Change in Production)
SECRET_KEY=sra-super-secret-key-change-in-production-lead-finder-2026
JWT_SECRET=sra-jwt-secret-key-change-in-production-lead-finder-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Optional External API Keys (Leave blank if using OpenStreetMap default)
GOOGLE_PLACES_API_KEY=
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
